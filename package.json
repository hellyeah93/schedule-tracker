{
  "name": "schedule-tracker",
  "version": "1.0.0",
  "description": "Daily schedule tracker, 2 Oct to 30 Dec 2026",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.scheduletracker",
    "productName": "Schedule Tracker",
    "files": ["www/**/*", "main.js", "package.json", "!node_modules/**/*"],
    "win": { "target": "portable" }
  }
}
